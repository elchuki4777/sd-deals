# Copy this file to .env.local and replace the placeholder values.
# Public browser values only. Never put a Supabase service_role key or OAuth client secret here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-or-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
